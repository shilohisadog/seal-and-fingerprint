    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mutation": "stryker run"
  },
  "devDependencies": {
    "@fast-check/vitest": "0.5.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "24.19.2",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
