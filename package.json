{
  "name": "seal-and-fingerprint",
  "version": "0.1.0",
  "private": true,
  "description": "Envelope encryption bound to a context, and keyed fingerprints of phone numbers and emails computed inside AWS KMS. Node's own crypto only; no runtime dependencies.",
